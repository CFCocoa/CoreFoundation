##===----------------------------------------------------------------------===##
##
## The CoreFoundation sources include ICU headers through the
## swift-foundation-icu prefix, e.g. `#include <_foundation_unicode/ucal.h>`.
## Rather than patching every source file (and fighting every upstream sync),
## this generates a directory of one-line forwarding headers at configure time:
##
##   <build>/icu-shim/_foundation_unicode/ucal.h  ->  #include <unicode/ucal.h>
##
## Only headers that exist in the ICU being used get a shim, so the sources'
## `__has_include(<_foundation_unicode/...>)` checks keep working for the
## Apple-only ICU additions that stock ICU lacks.
##
## SPDX-License-Identifier: Apache-2.0
##
##===----------------------------------------------------------------------===##

function(cf_generate_icu_shim target icu_include_dir)
    set(shim_dir "${CMAKE_CURRENT_BINARY_DIR}/icu-shim")
    file(GLOB sources CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/*.c"
        "${CMAKE_CURRENT_SOURCE_DIR}/internalInclude/*.h"
        "${CMAKE_CURRENT_SOURCE_DIR}/include/*.h")

    set(names)
    foreach(source IN LISTS sources)
        file(STRINGS "${source}" lines REGEX "#[ \t]*include[ \t]*<_foundation_unicode/[A-Za-z0-9_]+\\.h>")
        foreach(line IN LISTS lines)
            string(REGEX REPLACE ".*<_foundation_unicode/([A-Za-z0-9_]+\\.h)>.*" "\\1" name "${line}")
            list(APPEND names "${name}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES names)
    list(SORT names)

    set(provided)
    set(skipped)
    foreach(name IN LISTS names)
        set(real_header)
        foreach(dir IN LISTS icu_include_dir)
            if(EXISTS "${dir}/unicode/${name}")
                set(real_header "${dir}/unicode/${name}")
                break()
            endif()
        endforeach()
        set(shim "${shim_dir}/_foundation_unicode/${name}")
        if(real_header)
            set(content "/* generated by CFIcuShim.cmake; do not edit */\n#include <unicode/${name}>\n")
            if(EXISTS "${shim}")
                file(READ "${shim}" existing)
            else()
                set(existing "")
            endif()
            if(NOT existing STREQUAL content)
                file(WRITE "${shim}" "${content}")
            endif()
            list(APPEND provided "${name}")
        else()
            if(EXISTS "${shim}")
                file(REMOVE "${shim}")
            endif()
            list(APPEND skipped "${name}")
        endif()
    endforeach()

    list(LENGTH provided n_provided)
    message(STATUS "ICU shim: forwarding ${n_provided} headers to <unicode/...>; not in this ICU: ${skipped}")
    target_include_directories(${target} PRIVATE "${shim_dir}")
endfunction()
